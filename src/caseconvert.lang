# ============================================================
# Multilingual file for the TOS 7 Docker application "caseconvert".
# File name MUST be: <appid>.lang
# Superset of both official 14-language lists; untranslated nodes use English,
# which the official guide explicitly allows.
# ============================================================


[en-us]
  name         = "Case Converter"
  auth         = "karentamrazyan"
  version      = "@@VERSION@@"
  descript     = "Case Converter is a small offline web app that changes the letter case of any text. Paste or type your text and switch it to sentence case, title case, capital case, lower case or upper case, with live word and character counts. Your text never leaves the device: the conversion runs in your browser and the app works entirely inside a container on your NAS - no ads, no tracking, no account."
  release_note = "1. Initial release. A fully offline web app that converts text between sentence, title, capital, lower and upper case, with live word and character counts. The static web files are embedded in this package and served by a non-root nginx container pulled from Docker Hub. Google Analytics, Google AdSense and the upstream contact form have been removed."
  important    = "Requires DockerEngine (the App Center installs it automatically if missing). The nginx container image is pulled from Docker Hub at install time (about 50 MB); after that the app works completely offline. Open it from the TOS desktop or at http://<NAS-IP>:8910/. All text conversion happens in your browser: nothing is uploaded, logged or stored. The app data directory /Volume*/DockerAppData/caseconvert/ only holds the extracted web files and can be deleted at any time to reset the app. Based on the MIT-licensed open-source Case Converter project (github.com/caseconverter/caseconverter)."

[zh-cn]
  name         = "大小写转换器"
  auth         = "karentamrazyan"
  version      = "@@VERSION@@"
  descript     = "大小写转换器是一个小巧的离线网页工具，用于转换任意文本的字母大小写。粘贴或输入文本，即可切换为句首大写、标题式大写、每个单词首字母大写、全小写或全大写，并实时显示字数与字符数。文本不会离开您的设备：转换在浏览器中完成，应用完全运行在 NAS 的容器内——无广告、无追踪、无需账号。"
  release_note = "1. 首次发布。完全离线的网页应用，可在句首大写、标题式大写、每词首字母大写、全小写与全大写之间转换文本，并实时显示字数与字符数。静态网页文件内嵌在本包中，由从 Docker Hub 拉取的非 root nginx 容器提供服务。已移除 Google Analytics、Google AdSense 及上游联系表单。"
  important    = "需要 DockerEngine（缺失时应用中心会自动提示安装）。安装时会从 Docker Hub 拉取 nginx 容器镜像（约 50MB）；此后应用完全离线运行。可从 TOS 桌面打开，或访问 http://<NAS-IP>:8910/。所有文本转换都在您的浏览器中完成：不上传、不记录、不存储。应用数据目录 /Volume*/DockerAppData/caseconvert/ 仅存放解压后的网页文件，随时可删除以重置应用。基于 MIT 许可的开源 Case Converter 项目（github.com/caseconverter/caseconverter）。"

[zh-hk]
  name         = "大小寫轉換器"
  auth         = "karentamrazyan"
  version      = "@@VERSION@@"
  descript     = "大小寫轉換器是一個小巧的離線網頁工具，用於轉換任意文字的字母大小寫。貼上或輸入文字，即可切換為句首大寫、標題式大寫、每個單詞首字母大寫、全小寫或全大寫，並即時顯示字數與字元數。文字不會離開您的裝置：轉換在瀏覽器中完成，應用完全在 NAS 的容器內執行——無廣告、無追蹤、無需帳號。"
  release_note = "1. 首次發佈。完全離線的網頁應用，可在句首大寫、標題式大寫、每詞首字母大寫、全小寫與全大寫之間轉換文字，並即時顯示字數與字元數。靜態網頁檔案內嵌在本套件中，由從 Docker Hub 下載的非 root nginx 容器提供服務。已移除 Google Analytics、Google AdSense 及上游聯絡表單。"
  important    = "需要 DockerEngine（缺少時應用中心會自動提示安裝）。安裝時會從 Docker Hub 下載 nginx 容器映像檔（約 50MB）；此後應用完全離線運行。可從 TOS 桌面開啟，或瀏覽 http://<NAS-IP>:8910/。所有文字轉換都在您的瀏覽器中完成：不上傳、不記錄、不儲存。應用資料目錄 /Volume*/DockerAppData/caseconvert/ 僅存放解壓後的網頁檔案，隨時可刪除以重設應用。基於 MIT 授權的開源 Case Converter 專案（github.com/caseconverter/caseconverter）。"

[fr-fr]
  name         = "Convertisseur de casse"
  auth         = "karentamrazyan"
  version      = "@@VERSION@@"
  descript     = "Case Converter est une petite application web hors ligne qui change la casse de n'importe quel texte. Collez ou saisissez votre texte et convertissez-le en casse de phrase, casse de titre, casse capitale, minuscules ou majuscules, avec le comptage des mots et des caractères en direct. Votre texte ne quitte jamais l'appareil : la conversion s'effectue dans le navigateur et l'application fonctionne entièrement dans un conteneur sur votre NAS - sans publicité, sans suivi, sans compte."
  release_note = "1. Version initiale. Application web entièrement hors ligne qui convertit le texte entre casse de phrase, casse de titre, casse capitale, minuscules et majuscules, avec comptage des mots et des caractères en direct. Les fichiers web statiques sont intégrés à ce paquet et servis par un conteneur nginx non root tiré de Docker Hub. Google Analytics, Google AdSense et le formulaire de contact d'origine ont été supprimés."
  important    = "Nécessite DockerEngine (l'App Center l'installe automatiquement s'il est absent). L'image du conteneur nginx est téléchargée depuis Docker Hub à l'installation (environ 50 Mo) ; ensuite l'application fonctionne entièrement hors ligne. Ouvrez-la depuis le bureau TOS ou à l'adresse http://<NAS-IP>:8910/. Toute la conversion de texte se fait dans votre navigateur : rien n'est téléversé, journalisé ni stocké. Le répertoire de données /Volume*/DockerAppData/caseconvert/ ne contient que les fichiers web extraits et peut être supprimé à tout moment pour réinitialiser l'application. Basé sur le projet open source Case Converter sous licence MIT (github.com/caseconverter/caseconverter)."

[de-de]
  name         = "Groß-/Kleinschreibung-Konverter"
  auth         = "karentamrazyan"
  version      = "@@VERSION@@"
  descript     = "Case Converter ist eine kleine Offline-Web-App, die die Groß-/Kleinschreibung beliebiger Texte ändert. Einfügen oder eingeben und in Satzschreibweise, Titel-Schreibweise, Kapitalisierte Schreibweise, Klein- oder Großbuchstaben umwandeln - mit Live-Wort- und Zeichenzählung. Ihr Text verlässt das Gerät nie: Die Umwandlung läuft im Browser, die App arbeitet vollständig in einem Container auf Ihrem NAS - ohne Werbung, ohne Tracking, ohne Konto."
  release_note = "1. Erstveröffentlichung. Vollständig offline arbeitende Web-App, die Text zwischen Satzschreibweise, Titel-Schreibweise, Großschreibung jedes Wortes, Klein- und Großbuchstaben umwandelt, mit Live-Wort- und Zeichenzählung. Die statischen Webdateien sind in diesem Paket enthalten und werden von einem nicht als root laufenden nginx-Container aus Docker Hub bereitgestellt. Google Analytics, Google AdSense und das ursprüngliche Kontaktformular wurden entfernt."
  important    = "Erfordert DockerEngine (das App Center installiert es bei Bedarf automatisch). Das nginx-Container-Image wird bei der Installation von Docker Hub geladen (ca. 50 MB); danach arbeitet die App vollständig offline. Öffnen Sie sie über den TOS-Desktop oder unter http://<NAS-IP>:8910/. Die gesamte Textumwandlung erfolgt in Ihrem Browser: nichts wird hochgeladen, protokolliert oder gespeichert. Das App-Datenverzeichnis /Volume*/DockerAppData/caseconvert/ enthält nur die entpackten Webdateien und kann jederzeit gelöscht werden, um die App zurückzusetzen. Basiert auf dem MIT-lizenzierten Open-Source-Projekt Case Converter (github.com/caseconverter/caseconverter)."

[it-it]
  name         = "Convertitore di maiuscole/minuscole"
  auth         = "karentamrazyan"
  version      = "@@VERSION@@"
  descript     = "Case Converter è una piccola web app offline che modifica le maiuscole/minuscole di qualsiasi testo. Incolla o digita il testo e convertilo in stile frase, stile titolo, iniziali maiuscole, minuscolo o maiuscolo, con conteggio di parole e caratteri in tempo reale. Il testo non lascia mai il dispositivo: la conversione avviene nel browser e l'app funziona interamente in un container sul tuo NAS - senza pubblicità, senza tracciamento, senza account."
  release_note = "1. Versione iniziale. Web app completamente offline che converte il testo tra stile frase, stile titolo, iniziali maiuscole, minuscolo e maiuscolo, con conteggio di parole e caratteri in tempo reale. I file web statici sono integrati in questo pacchetto e serviti da un container nginx non root prelevato da Docker Hub. Google Analytics, Google AdSense e il modulo di contatto originale sono stati rimossi."
  important    = "Richiede DockerEngine (l'App Center lo installa automaticamente se assente). L'immagine del container nginx viene scaricata da Docker Hub al momento dell'installazione (circa 50 MB); dopodiché l'app funziona completamente offline. Aprila dal desktop TOS o all'indirizzo http://<NAS-IP>:8910/. Tutta la conversione del testo avviene nel browser: nulla viene caricato, registrato o memorizzato. La directory dati /Volume*/DockerAppData/caseconvert/ contiene solo i file web estratti e può essere eliminata in qualsiasi momento per reimpostare l'app. Basata sul progetto open source Case Converter con licenza MIT (github.com/caseconverter/caseconverter)."

[es-es]
  name         = "Conversor de mayúsculas y minúsculas"
  auth         = "karentamrazyan"
  version      = "@@VERSION@@"
  descript     = "Case Converter es una pequeña aplicación web sin conexión que cambia las mayúsculas y minúsculas de cualquier texto. Pega o escribe el texto y conviértelo a estilo de oración, estilo de título, iniciales mayúsculas, minúsculas o MAYÚSCULAS, con recuento de palabras y caracteres en vivo. El texto nunca sale de tu dispositivo: la conversión se ejecuta en el navegador y la app funciona por completo en un contenedor de tu NAS: sin anuncios, sin rastreo y sin cuenta."
  release_note = "1. Versión inicial. Aplicación web totalmente sin conexión que convierte el texto entre estilo de oración, estilo de título, iniciales mayúsculas, minúsculas y MAYÚSCULAS, con recuento de palabras y caracteres en vivo. Los archivos web estáticos están integrados en este paquete y los sirve un contenedor nginx sin root obtenido de Docker Hub. Se han eliminado Google Analytics, Google AdSense y el formulario de contacto original."
  important    = "Requiere DockerEngine (el App Center lo instala automáticamente si falta). La imagen del contenedor nginx se descarga de Docker Hub durante la instalación (unos 50 MB); después, la app funciona totalmente sin conexión. Ábrela desde el escritorio de TOS o en http://<NAS-IP>:8910/. Toda la conversión de texto ocurre en tu navegador: no se sube, registra ni almacena nada. El directorio de datos /Volume*/DockerAppData/caseconvert/ solo contiene los archivos web extraídos y puede eliminarse en cualquier momento para restablecer la app. Basada en el proyecto de código abierto Case Converter con licencia MIT (github.com/caseconverter/caseconverter)."

[hu-hu]
  name         = "Kis- és nagybetű átalakító"
  auth         = "karentamrazyan"
  version      = "@@VERSION@@"
  descript     = "A Case Converter egy kis offline webalkalmazás, amely bármely szöveg kis- és nagybetűit átalakítja. Illessze be vagy írja be a szöveget, majd alakítsa mondatkezdő, cím-, kezdőbetűs, kis- vagy nagybetűs formára, élő szó- és karakterszámlálással. A szöveg soha nem hagyja el az eszközt: az átalakítás a böngészőben fut, az alkalmazás pedig teljes egészében a NAS konténerében működik - reklám, követés és fiók nélkül."
  release_note = "1. Első kiadás. Teljesen offline webalkalmazás, amely a szöveget mondatkezdő, cím-, kezdőbetűs, kis- és nagybetűs formák között alakítja, élő szó- és karakterszámlálással. A statikus webfájlok ebben a csomagban találhatók, és egy Docker Hubból származó, nem root nginx konténer szolgálja ki őket. A Google Analytics, a Google AdSense és az eredeti kapcsolatfelvételi űrlap eltávolításra került."
  important    = "DockerEngine szükséges (az App Center hiány esetén automatikusan telepíti). Az nginx konténer image telepítéskor töltődik le a Docker Hubból (kb. 50 MB); ezután az alkalmazás teljesen offline működik. Nyissa meg a TOS asztalról vagy a http://<NAS-IP>:8910/ címen. Minden szövegátalakítás a böngészőben történik: semmit nem tölt fel, naplóz vagy tárol. Az alkalmazás adatkönyvtára (/Volume*/DockerAppData/caseconvert/) csak a kicsomagolt webfájlokat tartalmazza, és bármikor törölhető az alkalmazás visszaállításához. Az MIT licencű, nyílt forráskódú Case Converter projekten alapul (github.com/caseconverter/caseconverter)."

[ja-jp]
  name         = "ケースコンバーター"
  auth         = "karentamrazyan"
  version      = "@@VERSION@@"
  descript     = "Case Converter は、任意のテキストの大文字・小文字を変換する小さなオフライン Web アプリです。テキストを貼り付けるか入力し、文頭のみ大文字、タイトルケース、各単語の先頭を大文字、すべて小文字、すべて大文字に変換できます。単語数と文字数もリアルタイムで表示します。テキストが端末の外に出ることはありません。変換はブラウザー内で実行され、アプリは NAS 上のコンテナー内だけで動作します。広告・追跡・アカウントはありません。"
  release_note = "1. 初回リリース。文頭のみ大文字、タイトルケース、各単語の先頭を大文字、すべて小文字、すべて大文字の相互変換ができる完全オフラインの Web アプリです。単語数と文字数もリアルタイムで表示します。静的 Web ファイルは本パッケージに同梱され、Docker Hub から取得した非 root の nginx コンテナーが配信します。Google Analytics、Google AdSense、および上流の問い合わせフォームは削除済みです。"
  important    = "DockerEngine が必要です（未導入の場合はアプリセンターが自動的に導入を促します）。インストール時に nginx コンテナーイメージを Docker Hub から取得します（約 50MB）。以降は完全にオフラインで動作します。TOS デスクトップまたは http://<NAS-IP>:8910/ から開けます。テキストの変換はすべてブラウザー内で行われ、アップロード・記録・保存は一切ありません。アプリのデータディレクトリ /Volume*/DockerAppData/caseconvert/ には展開された Web ファイルのみが入り、いつでも削除して初期化できます。MIT ライセンスのオープンソースプロジェクト Case Converter を基にしています（github.com/caseconverter/caseconverter）。"

[ko-kr]
  name         = "대소문자 변환기"
  auth         = "karentamrazyan"
  version      = "@@VERSION@@"
  descript     = "Case Converter는 모든 텍스트의 대소문자를 변환하는 작은 오프라인 웹 앱입니다. 텍스트를 붙여넣거나 입력한 뒤 문장 첫 글자 대문자, 제목 형식, 각 단어 첫 글자 대문자, 모두 소문자, 모두 대문자로 변환할 수 있으며 단어 수와 문자 수가 실시간으로 표시됩니다. 텍스트는 기기를 벗어나지 않습니다. 변환은 브라우저에서 실행되고 앱은 NAS의 컨테이너 안에서만 동작합니다. 광고, 추적, 계정이 없습니다."
  release_note = "1. 최초 릴리스. 문장 첫 글자 대문자, 제목 형식, 각 단어 첫 글자 대문자, 모두 소문자, 모두 대문자 간 변환이 가능한 완전 오프라인 웹 앱입니다. 단어 수와 문자 수를 실시간으로 표시합니다. 정적 웹 파일은 이 패키지에 포함되어 있으며 Docker Hub에서 가져온 비루트 nginx 컨테이너가 제공합니다. Google Analytics, Google AdSense 및 업스트림 문의 양식은 제거되었습니다."
  important    = "DockerEngine이 필요합니다(없으면 App Center가 자동으로 설치를 안내합니다). 설치 시 nginx 컨테이너 이미지를 Docker Hub에서 내려받으며(약 50MB), 이후에는 완전히 오프라인으로 동작합니다. TOS 데스크톱 또는 http://<NAS-IP>:8910/ 에서 여세요. 모든 텍스트 변환은 브라우저에서 이루어지며 업로드·기록·저장되지 않습니다. 앱 데이터 디렉터리 /Volume*/DockerAppData/caseconvert/ 에는 압축을 푼 웹 파일만 있으며 언제든지 삭제해 초기화할 수 있습니다. MIT 라이선스 오픈 소스 프로젝트 Case Converter 기반입니다(github.com/caseconverter/caseconverter)."

[pl-pl]
  name         = "Konwerter wielkości liter"
  auth         = "karentamrazyan"
  version      = "@@VERSION@@"
  descript     = "Case Converter to mała aplikacja internetowa działająca offline, która zmienia wielkość liter w dowolnym tekście. Wklej lub wpisz tekst i zmień go na zapis zdaniowy, tytułowy, z wielkimi literami na początku wyrazów, małe lub WIELKIE litery, z licznikiem słów i znaków na żywo. Tekst nigdy nie opuszcza urządzenia: konwersja odbywa się w przeglądarce, a aplikacja działa w całości w kontenerze na Twoim NAS - bez reklam, bez śledzenia, bez konta."
  release_note = "1. Pierwsze wydanie. W pełni offline aplikacja internetowa, która konwertuje tekst między zapisem zdaniowym, tytułowym, wielką literą każdego wyrazu, małymi i WIELKIMI literami, z licznikiem słów i znaków na żywo. Statyczne pliki internetowe są dołączone do tego pakietu i serwowane przez nieuruchamiany jako root kontener nginx z Docker Hub. Usunięto Google Analytics, Google AdSense oraz oryginalny formularz kontaktowy."
  important    = "Wymaga DockerEngine (App Center zainstaluje go automatycznie, jeśli go brak). Obraz kontenera nginx jest pobierany z Docker Hub podczas instalacji (ok. 50 MB); następnie aplikacja działa całkowicie offline. Otwórz ją z pulpitu TOS lub pod adresem http://<NAS-IP>:8910/. Cała konwersja tekstu odbywa się w przeglądarce: nic nie jest przesyłane, rejestrowane ani przechowywane. Katalog danych aplikacji /Volume*/DockerAppData/caseconvert/ zawiera tylko rozpakowane pliki internetowe i można go w każdej chwili usunąć, aby zresetować aplikację. Oparta na projekcie open source Case Converter na licencji MIT (github.com/caseconverter/caseconverter)."

[ru-ru]
  name         = "Конвертер регистра"
  auth         = "karentamrazyan"
  version      = "@@VERSION@@"
  descript     = "Case Converter — это небольшое офлайн-веб-приложение для изменения регистра букв в любом тексте. Вставьте или введите текст и преобразуйте его в регистр предложения, заголовка, с заглавной буквы каждого слова, в нижний или ВЕРХНИЙ регистр; количество слов и символов отображается в реальном времени. Текст не покидает устройство: преобразование выполняется в браузере, а приложение работает полностью в контейнере на вашем NAS — без рекламы, без отслеживания, без учётной записи."
  release_note = "1. Первый выпуск. Полностью офлайн веб-приложение, преобразующее текст между регистром предложения, регистром заголовка, заглавной первой буквой каждого слова, нижним и ВЕРХНИМ регистром, с подсчётом слов и символов в реальном времени. Статические веб-файлы включены в этот пакет и обслуживаются контейнером nginx (не root) из Docker Hub. Google Analytics, Google AdSense и исходная контактная форма удалены."
  important    = "Требуется DockerEngine (App Center установит его автоматически при отсутствии). При установке образ контейнера nginx загружается с Docker Hub (около 50 МБ); после этого приложение работает полностью офлайн. Откройте его с рабочего стола TOS или по адресу http://<NAS-IP>:8910/. Всё преобразование текста выполняется в браузере: ничего не загружается, не логируется и не сохраняется. Каталог данных приложения /Volume*/DockerAppData/caseconvert/ содержит только распакованные веб-файлы и может быть удалён в любой момент для сброса приложения. Основано на открытом проекте Case Converter под лицензией MIT (github.com/caseconverter/caseconverter)."

[tr-tr]
  name         = "Büyük/küçük harf dönüştürücü"
  auth         = "karentamrazyan"
  version      = "@@VERSION@@"
  descript     = "Case Converter, herhangi bir metnin büyük/küçük harf durumunu değiştiren küçük bir çevrimdışı web uygulamasıdır. Metni yapıştırın veya yazın; cümle düzeni, başlık düzeni, her sözcüğün ilk harfi büyük, tümü küçük veya TÜMÜ BÜYÜK biçimlerine dönüştürün; sözcük ve karakter sayıları anında görünür. Metniniz cihazdan hiç ayrılmaz: dönüştürme tarayıcıda çalışır ve uygulama tamamen NAS'ınızdaki bir kapsayıcı içinde çalışır - reklam yok, izleme yok, hesap yok."
